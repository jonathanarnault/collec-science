#--------------------------------------------------------------------
# Docker development configuration
# Copied to .env on the first start of the app container
# See the env file at the root of the project for all the parameters
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

# disable totp identification in admin mode
Ppci\Config\IdentificationConfig.disableTotpToAdmin=1

app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false
BASE_DIR = "/var/www/collec2App/collec-science"
FRONT_DIR = "${BASE_DIR}/public"

TEMP = "${BASE_DIR}/writable/temp"
app.APP_temp = "${TEMP}"
session.savePath = "${TEMP}/sessions"
session.expiration = 14400

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = db
database.default.database = collec
database.default.username = collec
database.default.password = collecPassword
database.default.DBDriver = Postgre
database.default.DBPrefix =
database.default.port = 5432
database.default.searchpath = col,gacl,public
database.default.charset = utf8

#--------------------------------------------------------------------
# Encryption
#--------------------------------------------------------------------
app.privateKey = ${BASE_DIR}/id_collec
app.pubKey = ${BASE_DIR}/id_collec.pub

#--------------------------------------------------------------------
# Identification
#--------------------------------------------------------------------
Ppci\Config\IdentificationConfig.identificationMode = MIXED
Ppci\Config\IdentificationConfig.mixedLocalIdentification = BDD

logger.threshold = 4

#--------------------------------------------------------------------
# MAILS - caught by maildev: http://localhost:1080
#--------------------------------------------------------------------
app.APP_mail = admin@collec.local
app.MAIL_enabled = 1
app.MAIL_param.from = collec@collec.local
app.MAIL_param.mailDebug = 0

app.checkRelease = 0
